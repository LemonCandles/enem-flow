# Docker Compose loads this file after copying it to .env.
POSTGRES_DB=enem_flow
POSTGRES_USER=enem_flow
POSTGRES_PASSWORD=troque-esta-senha-local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# Rede privada entre o gateway e a API; ajuste os dois valores se houver conflito.
ENEM_PROXY_SUBNET=172.30.246.0/24
ENEM_PROXY_IP=172.30.246.254
# Local shell only: export this to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql+psycopg://enem_flow:troque-esta-senha-local@localhost:5432/enem_flow

# Tutor (API compatível com a OpenAI; padrão: Groq). Sem chave, a prática mostra só o
# material aprovado. Crie a chave em https://console.groq.com/keys e confira modelo e preços
# na página do Groq: os valores abaixo são exemplos e o custo registrado depende deles.
GROQ_API_KEY=
TUTOR_BASE_URL=https://api.groq.com/openai/v1
TUTOR_MODEL=llama-3.3-70b-versatile
# Limites obrigatórios para chamar o provedor: tempo, tamanho da resposta, uso diário por
# aluno e custo máximo estimado por chamada (US$). Preços em US$ por milhão de tokens.
TUTOR_TIMEOUT_SECONDS=10
TUTOR_MAX_OUTPUT_TOKENS=500
TUTOR_DAILY_LIMIT=40
TUTOR_PRICE_INPUT_PER_MTOK=0.59
TUTOR_PRICE_OUTPUT_PER_MTOK=0.79
TUTOR_MAX_COST_USD=0.01
