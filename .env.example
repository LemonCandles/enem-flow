# Docker Compose loads this file after copying it to .env.
POSTGRES_DB=enem_flow
POSTGRES_USER=enem_flow
POSTGRES_PASSWORD=troque-esta-senha-local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# Rede privada entre o gateway e a API; ajuste os dois valores se houver conflito.
ENEM_PROXY_SUBNET=172.30.246.0/24
ENEM_PROXY_IP=172.30.246.254
# Local shell only: export this to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql+psycopg://enem_flow:troque-esta-senha-local@localhost:5432/enem_flow
