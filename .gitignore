# Ambiente local; manter os modelos de configuração versionáveis.
.env
.env.*
!.env.example
!.env.*.example

# Credenciais e estado local de ferramentas externas ao projeto.
/.aws/
/.agents/
/.codex/

# Python: ambientes, bytecode, caches, cobertura e empacotamento.
/.venv
/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
/build/
/dist/
.coverage
.coverage.*
coverage.xml
/htmlcov/

# Node.js e Next.js: dependências, builds e arquivos gerados pelo framework.
# next-env.d.ts é reescrito por `next dev` e `next build`; o typecheck não depende dele.
node_modules
.next/
/frontend/next-env.d.ts
/frontend/out/
/frontend/coverage/
*.tsbuildinfo

# Resultados do Playwright: vídeos, traces e capturas de cada execução.
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Bancos de execução, arquivos auxiliares do SQLite e backups locais.
# O padrão *.db também cobre o Thumbs.db do Windows.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
/backups/
/assets-backup/
/sources-backup/
*.deployment-state.json

# Temporários, downloads interrompidos, logs e arquivos do sistema/editor.
/tmp/
*.tmp
*.part
*.log
*.bak
*.swp
*.swo
.DS_Store
Desktop.ini
.idea/

# Dados: entram os dois lotes conferidos (ENEM 2024, 2º dia azul, e
# Matemática 2023 azul), com figuras, PDFs de prova e gabarito, bases de
# revisão, anotações e o dataset de referência, além de documentação, exemplo
# de manifesto, taxonomia e catálogo de fontes. Também entram as provas geradas
# da aplicação regular de 2024 (1º dia) e 2025 (1º e 2º dias), caderno azul, com
# JSON, relatório, figuras e PDFs; seguem sendo extração automática, sem
# equivaler a conteúdo conferido. O restante do acervo, o banco textual e os
# caches são recuperados pelo catálogo com SHA-256 ou regenerados pelos scripts.
# Novos arquivos e pastas em data/ ficam locais até serem liberados
# explicitamente aqui.
/data/*
!/data/README.md
!/data/enem-2024-dia2-azul.json
!/data/assets/
# Figuras: as dos lotes conferidos e as das provas regulares de 2024 e 2025; as
# demais provas geradas do acervo ficam locais.
/data/assets/*
!/data/assets/enem-2024-dia2-azul/
!/data/assets/enem-2023-matematica-azul/
!/data/assets/enem-2024-regular-dia1-caderno-1-azul-ingles/
!/data/assets/enem-2024-regular-dia1-caderno-1-azul-espanhol/
!/data/assets/enem-2025-regular-dia1-caderno-1-azul-ingles/
!/data/assets/enem-2025-regular-dia1-caderno-1-azul-espanhol/
!/data/assets/enem-2025-regular-dia2-caderno-7-azul/
!/data/catalog/
!/data/classification/
!/data/datasets/
!/data/examples/
!/data/taxonomy/

# Derivados: as bases imutáveis de revisão e, em exams/, JSON e relatório das
# provas regulares de 2024 e 2025; archive/ e assets/ são caches.
!/data/derived/
/data/derived/*
!/data/derived/baselines/
!/data/derived/exams/
/data/derived/exams/*
!/data/derived/exams/enem-2024-regular-dia1-caderno-1-azul-ingles.json
!/data/derived/exams/enem-2024-regular-dia1-caderno-1-azul-ingles.report.json
!/data/derived/exams/enem-2024-regular-dia1-caderno-1-azul-espanhol.json
!/data/derived/exams/enem-2024-regular-dia1-caderno-1-azul-espanhol.report.json
!/data/derived/exams/enem-2025-regular-dia1-caderno-1-azul-ingles.json
!/data/derived/exams/enem-2025-regular-dia1-caderno-1-azul-ingles.report.json
!/data/derived/exams/enem-2025-regular-dia1-caderno-1-azul-espanhol.json
!/data/derived/exams/enem-2025-regular-dia1-caderno-1-azul-espanhol.report.json
!/data/derived/exams/enem-2025-regular-dia2-caderno-7-azul.json
!/data/derived/exams/enem-2025-regular-dia2-caderno-7-azul.report.json

# Nenhum PDF de data/ entra, exceto as fontes dos lotes conferidos e das provas
# regulares de 2024 e 2025 abaixo.
/data/**/*.pdf

# Fontes oficiais: guia, inventário do acervo (URLs, SHA-256, páginas oficiais
# preservadas e intermediário TLS), manifesto da matriz de referência e PDFs
# dos lotes conferidos e do caderno azul das provas regulares de 2024 e 2025.
# Os demais originais são recuperados pelo catálogo.
!/data/sources/
/data/sources/*
!/data/sources/README.md
!/data/sources/catalogo/
!/data/sources/referencias/
/data/sources/referencias/*
!/data/sources/referencias/manifesto.json
!/data/sources/enem/
/data/sources/enem/**
!/data/sources/enem/**/
!/data/sources/enem/2023/regular/impresso/dia-2/caderno-7-azul/prova.pdf
!/data/sources/enem/2023/regular/impresso/dia-2/caderno-7-azul/gabarito.pdf
!/data/sources/enem/2024/regular/impresso/dia-2/caderno-7-azul/prova.pdf
!/data/sources/enem/2024/regular/impresso/dia-2/caderno-7-azul/gabarito.pdf
!/data/sources/enem/2024/regular/impresso/dia-1/caderno-1-azul/prova.pdf
!/data/sources/enem/2024/regular/impresso/dia-1/caderno-1-azul/gabarito.pdf
!/data/sources/enem/2025/regular/impresso/dia-1/caderno-1-azul/prova.pdf
!/data/sources/enem/2025/regular/impresso/dia-1/caderno-1-azul/gabarito.pdf
!/data/sources/enem/2025/regular/impresso/dia-2/caderno-7-azul/prova.pdf
!/data/sources/enem/2025/regular/impresso/dia-2/caderno-7-azul/gabarito.pdf
